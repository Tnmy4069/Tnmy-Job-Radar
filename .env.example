# MongoDB connection string used by Prisma
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/job-radar?retryWrites=true&w=majority"

# Optional. Required for /api/cron/scan in production.
SCAN_SECRET=""

# Superadmin (sign in at /admin69)
ADMIN_EMAIL="admin@jobradar.local"
ADMIN_PASSWORD="change-me"

# Public site URL (used in README / cron docs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Official-source fetch (never used to evade blocks)
SOURCE_REQUEST_DELAY_MS="500"
HTTP_TIMEOUT_MS="20000"
HTTP_MAX_RETRIES="2"
COMPANY_SCAN_TIMEOUT_MS="90000"
BROWSER_TIMEOUT_MS="45000"
# Local Scan now / `npm run scan` only. Never enable on Vercel.
# Requires: npm i -D playwright && npx playwright install chromium
BROWSER_FETCH_ENABLED="false"
MAX_PAGES_PER_SOURCE="50"
MAX_DETAIL_PAGES_PER_SOURCE="40"
SCAN_CONCURRENCY="2"
SOURCE_VERIFY_CONCURRENCY="3"

# Gemini intelligence layer (server-side only — never NEXT_PUBLIC_)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL=""
GEMINI_ENABLED="true"
GEMINI_MIN_SCORE="70"
GEMINI_MAX_CONCURRENCY="10"
GEMINI_INITIAL_CONCURRENCY="5"
GEMINI_MAX_RETRIES="3"
GEMINI_BATCH_SIZE="5"
GEMINI_TIMEOUT_MS="30000"
GEMINI_DAILY_MAX_JOBS=""
GEMINI_DAILY_MAX_TOKENS=""
CANDIDATE_PROFILE_VERSION="1"
GEMINI_PROMPT_VERSION="job-fit-v1"
PRIORITY_AI_WEIGHT="0.5"
PRIORITY_RULE_WEIGHT="0.3"
PRIORITY_FRESHNESS_WEIGHT="0.2"
